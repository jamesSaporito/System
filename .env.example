# Copy to .env for native development (`cp .env.example .env`).
# Docker Compose reads .env too, but sets its own DATABASE_URL for containers.

# Backend
PORT=4000
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
BETTER_AUTH_URL=http://localhost:4000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Admins: comma-separated numeric GitHub user IDs (https://api.github.com/users/<username> → "id").
# They manage members in the admin; everyone else needs to be added as a member to sign in.
ADMIN_GITHUB_IDS=
ADMIN_URL=http://localhost:3001

# Admin: NEXT_PUBLIC_BACKEND_URL is read from the environment when apps/admin is built
# (Next.js doesn't load this root file). It defaults to http://localhost:4000.
