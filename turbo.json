{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/**"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "db:generate", "^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "db:generate", "^db:generate"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      // Strict env mode would otherwise drop values set by docker-compose.yml.
      "passThroughEnv": ["PORT", "DATABASE_URL"],
      "cache": false,
      "persistent": true
    }
  }
}
