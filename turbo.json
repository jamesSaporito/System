{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc"],
  // Strict env mode would otherwise drop values docker-compose.yml sets for containers.
  "globalPassThroughEnv": ["DATABASE_URL", "DEV_CONTAINER"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    // Starts Postgres via docker compose (a no-op inside the dev container).
    "db:up": {
      "cache": false
    },
    "db:deploy": {
      "dependsOn": ["db:up"],
      "cache": false
    },
    // Starts s3mock for native dev (a no-op inside the dev container).
    "media:up": {
      "cache": false
    },
    // Sync apps/portfolio/media/ with its S3 bucket (s3mock unless S3_ENDPOINT is set empty).
    "media:push": {
      "dependsOn": ["media:up"],
      "passThroughEnv": ["S3_ENDPOINT", "MEDIA_BUCKET", "AWS_*"],
      "cache": false
    },
    "media:pull": {
      "dependsOn": ["media:up"],
      "passThroughEnv": ["S3_ENDPOINT", "MEDIA_BUCKET", "AWS_*"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "db:generate", "^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "db:generate", "^db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate", "^db:generate", "^db:deploy"],
      // Tests hit the local database, so results aren't reproducible from inputs alone.
      "cache": false
    },
    "dev": {
      // The backend gets a running, migrated database; the portfolio gets s3mock for photos.
      "dependsOn": ["^db:generate", "^db:deploy", "media:up"],
      "passThroughEnv": ["PORT"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
