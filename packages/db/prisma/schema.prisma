generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Database naming: plural snake_case tables, snake_case columns, lowercase enum values.
// Prisma has no global naming setting, so every model, multi-word field, and enum is mapped.

enum SiteRole {
  /// Edits content, publishes, and manages the site's members.
  OWNER  @map("owner")
  /// Edits content only.
  EDITOR @map("editor")

  @@map("site_role")
}

/// A portfolio with its own domain and its own frontend app in sites/<slug>.
model Site {
  id        String       @id @default(uuid(7))
  /// Matches the frontend app's folder, sites/<slug>.
  slug      String       @unique
  name      String
  /// Public domain, e.g. www.example.com. Informational; hosting is configured in Terraform.
  domain    String?
  members   SiteMember[]
  invites   SiteInvite[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("sites")
}

model SiteMember {
  siteId    String   @map("site_id")
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      SiteRole
  createdAt DateTime @default(now()) @map("created_at")

  @@id([siteId, userId])
  @@index([userId])
  @@map("site_members")
}

/// A pending invite, turned into a SiteMember when that GitHub account first signs in.
model SiteInvite {
  id          String   @id @default(uuid(7))
  siteId      String   @map("site_id")
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Numeric GitHub user ID; matches accounts.account_id once they sign in.
  githubId    String   @map("github_id")
  githubLogin String   @map("github_login")
  role        SiteRole
  invitedById String?  @map("invited_by_id")
  invitedBy   User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([siteId, githubId])
  @@index([githubId])
  @@map("site_invites")
}

// --- Better Auth (core). Field names must match what Better Auth expects;
// it goes through the Prisma client, so only the database names are mapped.

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  sessions      Session[]
  accounts      Account[]
  memberships   SiteMember[]
  invitesSent   SiteInvite[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
